<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="TenantWebServices" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="ObjectTypeByInt">
    <xs:restriction base="xs:int">
      <xs:enumeration value="5"/>
      <xs:enumeration value="8"/>
      <xs:enumeration value="9"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ObjectTypeByString">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Page"/>
      <xs:enumeration value="CodeUnit"/>
      <xs:enumeration value="Query"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ObjectType">
    <xs:union memberTypes="ObjectTypeByInt ObjectTypeByString"/>
  </xs:simpleType>

  <xs:complexType name ="TenantWebService">
    <xs:all>
      <xs:element name="ObjectType" type="ObjectType">
        <xs:annotation>
          <xs:documentation>Type of Object</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ObjectID" type="xs:int">
        <xs:annotation>
          <xs:documentation>Id of Object</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ServiceName" type="xs:string">
        <xs:annotation>
          <xs:documentation>Name of the Service</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Published" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Exposed state</xs:documentation>
        </xs:annotation>
      </xs:element>
        </xs:all>
  </xs:complexType>
  
  <xs:complexType name="TenantWebServiceCollection">
    <xs:sequence>
      <xs:element name="TenantWebService" type="TenantWebService" minOccurs = "1" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:element name="ExportedData">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="TenantWebServiceCollection" type="TenantWebServiceCollection">
          <xs:unique name="uniqueServices">
            <xs:selector xpath="TenantWebService"/>
            <xs:field xpath="ObjectType"/>
            <xs:field xpath="ServiceName"/>
            <xs:field xpath="ObjectID"/>
          </xs:unique>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
