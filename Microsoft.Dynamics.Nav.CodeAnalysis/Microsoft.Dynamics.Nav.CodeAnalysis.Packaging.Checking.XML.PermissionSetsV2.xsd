<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="PermissionSets" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <xs:simpleType name="PermissionByInt">
    <xs:restriction base="xs:int">
      <xs:maxInclusive value="2"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PermissionByString">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Yes"/>
      <xs:enumeration value="No"/>
      <xs:enumeration value="Indirect"/>
    </xs:restriction>
  </xs:simpleType>
  
  <xs:simpleType name="PermissionType">
    <xs:union memberTypes="PermissionByInt PermissionByString"/>
  </xs:simpleType>
  
  <xs:simpleType name="ObjectTypeByString">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Codeunit"/>
      <xs:enumeration value="Dataport"/>
      <xs:enumeration value="FieldNumber"/>
      <xs:enumeration value="Form"/>
      <xs:enumeration value="LimitedUsageTableData"/>
      <xs:enumeration value="MenuSuite"/>
      <xs:enumeration value="Page"/>
      <xs:enumeration value="Query"/>
      <xs:enumeration value="Report"/>
      <xs:enumeration value="System"/>
      <xs:enumeration value="Table"/>
      <xs:enumeration value="TableData"/>
      <xs:enumeration value="TablePage"/>
      <xs:enumeration value="XMLport"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ObjectTypeByInt">
    <xs:restriction base="xs:int">
      <xs:maxInclusive value="12"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ObjectType">
    <xs:union memberTypes="ObjectTypeByInt ObjectTypeByString"/>
  </xs:simpleType>

  <xs:complexType name="Permission">
    <xs:all>      
      <xs:element name="ObjectType" type="ObjectType">
        <xs:annotation>
          <xs:documentation>Type of object</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ObjectID" type="xs:int">
        <xs:annotation>
          <xs:documentation>Unique NAV id for object</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ReadPermission" type="PermissionType">
        <xs:annotation>
          <xs:documentation>Read permission level</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="InsertPermission" type="PermissionType">
        <xs:annotation>
          <xs:documentation>Insert permission level</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ModifyPermission" type="PermissionType">
        <xs:annotation>
          <xs:documentation>Modify permission level</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="DeletePermission" type="PermissionType">
        <xs:annotation>
          <xs:documentation>Delete permission level</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ExecutePermission" type="PermissionType">
        <xs:annotation>
          <xs:documentation>Execute permission level</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="SecurityFilter" type="xs:string">
        <xs:annotation>
          <xs:documentation>User access filter</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
  </xs:complexType>
  
  <xs:complexType name="PermissionSet">
    <xs:sequence>
      <xs:element name="Permission" type="Permission" minOccurs="1" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Object permissions entry</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="RoleID" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Unique identifier for the permission set</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="RoleName" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Name or description of permission set</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  
  <xs:element name="PermissionSets">
    <xs:complexType>
      <xs:sequence minOccurs="1" maxOccurs="unbounded">
        <xs:element name="PermissionSet" type="PermissionSet">
          <xs:unique name="uniquePermissionsForObjects">
            <xs:selector xpath="Permission"/>
            <xs:field xpath="ObjectType"/>
            <xs:field xpath="ObjectID"/>
          </xs:unique>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <xs:unique name="uniqueRoleids">
      <xs:selector xpath="PermissionSet"/>
      <xs:field xpath="@RoleID"/>
    </xs:unique>
  </xs:element>
</xs:schema>
