    { Insertion         ;InsertAfter=GetTotalBalance(PROCEDURE 3);
                         ChangedElements=PROCEDURECollection
                         {
                           PROCEDURE AddLoyaltyPoints@1000000000(Points@1000000000 : Integer);
                           BEGIN
                             "Loyalty Points" += Points;
                             MODIFY(TRUE);
                           END;

                         }
                          }
    { CodeModification  ;OriginalCode=BEGIN
                                        "Last Date Modified" := TODAY;
                                      END;

                         ModifiedCode=BEGIN
                                        "Last Date Modified" := TODAY;
