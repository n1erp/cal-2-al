
#===== Tables, Fields and Keys INFORMATION ========================================
#
# <boolean expression> - is an expression which is to be evaluated during whitelising the changes.
#    If the result is true, then the change is considered to be in a white list and allowed. Otherwise the
#    change is considered to be NOT allowed. You can have multiple <boolean expression>s for a given change.
#    If either one of them is true, the change is considered to be in a whitelist and allowed.
#
#    You can use logical operators (or, and, not) here, 'like' operator to compare strings, as well as
#    boolean values (true, false). Enclose strings inside single quotes, not double quotes. You can use
#    parenthesis and comparison operators (<, >, <=, >=, <>, =).
#
# For Tables you can use functions inside these expressions:
#
#    TableProperty(<property name>) - results in a string representation of a given property for the table.
#
# For Keys you can use functions inside these expressions:
#
#    TableProperty(<property name>) - results in a string representation of a given property for the table.
#
#    KeyProperty(<property name>) - results in a string representation of a given property for the key.
#    KeyProperty(IsPrimary) - returns a boolean if a given key is primary or not.
#    KeyProperty(Name) - returns a string representation of fields of a given key.
#
# For Fields you can use functions inside these expressions:
#
#    TableProperty(<property name>) - results in a string representation of a given property for the table.
#
#    FieldProperty(<property name>) - results in a string representation of a given property for the field.
#    FieldProperty(DataLength) - results in a number representation of a data length for the field.
#

#===== Tables =====
# Table
#     Deletion:
#         <boolean expression>
#     Insertion:
#         <boolean expression>
#

Table
	Deletion:
		TableProperty(TableType) <> 'Normal'
	Insertion:
		true

#===== Fields =====
# Field
#     Deletion:
#         <boolean expression>
#     Insertion:
#         <boolean expression>
#

Field
	Deletion:
		TableProperty(TableType) <> 'Normal'
		FieldProperty(FieldClass) <> 'Normal'
	Insertion:
		true

#===== Keys =====
# Key
#     Deletion:
#         <boolean expression>
#     Insertion:
#         <boolean expression>
#

Key
	Insertion:
		TableProperty(TableType) <> 'Normal'
		not (KeyProperty(IsPrimary) or (KeyProperty(Unique) = 'Yes'))
	Deletion:
		TableProperty(TableType) <> 'Normal'
		not (KeyProperty(IsPrimary) or (KeyProperty(Unique) = 'Yes'))

#===== Table Properties, Field Properties and Key Properties INFORMATION ========================================
#
# <boolean expression> - is an expression which is to be evaluated during whitelising the changes.
#    If the result is true, then the change is considered to be in a white list and allowed. Otherwise the
#    change is considered to be NOT allowed. You can have multiple <boolean expression>s for a given change.
#    If either one of them is true, the change is considered to be in a whitelist and allowed.
#
#    You can use logical operators (or, and, not) here, as well as boolean values (true, false). Enclose
#    strings inside single quotes, not double quotes. You can use parenthesis and comparison operators
#    (<, >, <=, >=, <>, =).
#
# For Table Properties and Key Properties you can use functions inside these expressions:
#
#    TableProperty(<property name>, <Before|After>) - results in a string representation of a given property
#        for the table, before or after modification respectively.
#
# For Field Properties you can use functions inside these expressions:
#
#    TableProperty(<property name>, <Before|After>) - results in a string representation of a given property
#        for the table, before or after modification respectively.
#
#    FieldProperty(<property name>, <Before|After>) - results in a string representation of a given property
#        for the field, before or after modification respectively.
#    FieldProperty(DataLength, <Before|After>) - results in a number representation of a data length for the
#        field, before or after modification respectively.
#    FieldProperty(FirstKeyIndex, <Before|After>) - if field is a part of any key, then it results in a number
#        representation of index of first key where the field is used, otherwise it is -1.
#    FieldProperty(IsPartOfActiveKey, <Before|After>) - results in a boolean if field is a part of any active
#        key (ObsoleteState is not 'Removed')
#
# For Key Properties you can use functions inside these expressions:
#
#    KeyProperty(<property name>, <Before|After>) - results in a string representation of a given property
#        for the key, before or after modification respectively.
#    KeyProperty(Name, <Before|After>) - results in a number representation of the name of the key,
#        before or after modification respectively.
#

#===== Table Properties =====
# TableProperty
#     <Property Name>:
#         <boolean expression>
#     <Property Name>:
#         <boolean expression>
#

TableProperty
	Caption:
		true
	CaptionML:
		true
	Description:
		true
	Permissions:
		true
	LookupPageID:
		true
	DrillDownPageID:
		true
	DataCaptionFields:
		true
	DataClassification:
		true
	PasteIsValid:
		true
	ReplicateData:
		true
	TableType:
		(TableProperty(TableType, Before) <> 'Normal') and (TableProperty(TableType, After) <> 'Normal')
	ObsoleteState:
		(TableProperty(ObsoleteState, After) = 'No') and (TableProperty(ObsoleteReason, After) = '')
		(TableProperty(ObsoleteState, After) = 'Pending') and (TableProperty(ObsoleteReason, After) <> '')
		(TableProperty(ObsoleteState, After) = 'Removed') and (TableProperty(ObsoleteReason, After) <> '')
	ObsoleteReason:
		(TableProperty(ObsoleteState, After) <> 'No') and (TableProperty(ObsoleteReason, After) <> '')
		(TableProperty(ObsoleteState, After) = 'No') and (TableProperty(ObsoleteReason, After) = '')

#===== Field Properties =====
# FieldProperty
#     <Property Name>:
#         <boolean expression>
#     <Property Name>:
#         <boolean expression>
#

FieldProperty
	Name:
		(FieldProperty(FieldClass, Before) <> 'Normal') and (FieldProperty(FieldClass, After) <> 'Normal')
		(TableProperty(TableType, Before) <> 'Normal') and (TableProperty(TableType, After) <> 'Normal')
	Caption:
		true
	CaptionML:
		true
	Description:
		true
	AccessByPermission:
		true
	AutoFormatType:
		true
	AutoFormatExpr:
		true
	AutoIncrement:
		true
	BlankNumbers:
		true
	BlankZero:
		true
	CaptionClass:
		true
	CharAllowed:
		true
	ClosingDates:
		true
	Compressed:
		true
	DataLength:
		(TableProperty(TableType, Before) <> 'Normal') and (TableProperty(TableType, After) <> 'Normal')
		(FieldProperty(DataLength, After) > FieldProperty(DataLength, Before)) and (not (FieldProperty(FirstKeyIndex, Before) = 0)) and (not (FieldProperty(FirstKeyIndex, After) = 0))
	DataClassification:
		true
	Editable:
		true
	EnumTypeId:
		true
	EnumTypeName:
		true
	Extensible:
		true
	ExternalAccess:
		true
	ExternalName:
		true
	ExternalType:
		true
	MaxValue:
		true
	MinValue:
		true
	NotBlank:
		true
	Numeric:
		true
	SignDisplacement:
		true
	CalcFormula:
		true
	TableRelation:
		true
	ValidateTableRelation:
		true
	TestTableRelation:
		true
	ValuesAllowed:
		true
	Width:
		true
	InitValue:
		true
	FieldClass:
		(TableProperty(TableType, Before) <> 'Normal') and (TableProperty(TableType, After) <> 'Normal')
		(FieldProperty(FieldClass, Before) <> 'Normal') and (FieldProperty(FieldClass, After) <> 'Normal')
	OptionOrdinalValues:
		true
	OptionString:
		true
	OptionCaptionML:
		true
	ObsoleteState:
		(FieldProperty(ObsoleteState, After) = 'No') and (FieldProperty(ObsoleteReason, After) = '')
		(FieldProperty(ObsoleteState, After) = 'Pending') and (FieldProperty(ObsoleteReason, After) <> '')
		(FieldProperty(ObsoleteState, After) = 'Removed') and (FieldProperty(ObsoleteReason, After) <> '') and (FieldProperty(ObsoleteState, Before) = 'Pending') and (not (FieldProperty(IsPartOfActiveKey, After)))
	ObsoleteReason:
		(FieldProperty(ObsoleteState, After) <> 'No') and (FieldProperty(ObsoleteReason, After) <> '')
		(FieldProperty(ObsoleteState, After) = 'No') and (FieldProperty(ObsoleteReason, After) = '')

#===== Key Properties =====
# KeyProperty
#     <Property Name>:
#         <boolean expression>
#     <Property Name>:
#         <boolean expression>
#

KeyProperty
	Name:
		KeyProperty(Name, After) LIKE (KeyProperty(Name, Before) + '*')
	SumIndexFields:
		true
	MaintainSQLIndex:
		true
	MaintainSIFTIndex:
		true
	ObsoleteState:
		(KeyProperty(ObsoleteState, After) = 'No') and (KeyProperty(ObsoleteReason, After) = '')
		(KeyProperty(ObsoleteState, After) = 'Pending') and (KeyProperty(ObsoleteReason, After) <> '')
		(KeyProperty(ObsoleteState, After) = 'Removed') and (KeyProperty(ObsoleteReason, After) <> '') and (KeyProperty(ObsoleteState, Before) = 'Pending')
	ObsoleteReason:
		(KeyProperty(ObsoleteState, After) <> 'No') and (KeyProperty(ObsoleteReason, After) <> '')
		(KeyProperty(ObsoleteState, After) = 'No') and (KeyProperty(ObsoleteReason, After) = '')
	Enabled:
		(KeyProperty(Enabled, Before) = 'No') and (KeyProperty(Enabled, After) = 'Yes')
